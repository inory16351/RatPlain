--- !u!114 &1491542593
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1491542591}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9a5c905ae3046c24d9307a164efefbcb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tutorial
  box: {fileID: 1629886610}
  boxText: {fileID: 3224690}
  tip: {fileID: 1840226921}
  tipTitle: {fileID: 2028238750}
  tipText: {fileID: 1524288510}
  tipTime: 4.5
  steps:
  - "<b>W</b> \uB85C \uB3DB\uC744 \uC62C\uB824\uB77C! \uCD9C\uD56D\uC774\uB2E4!"
  - "<b>A \xB7 D</b> \uB85C \uD0A4\uB97C \uB3CC\uB824 \uBC29\uD5A5\uC744 \uD2C0\uC5B4\uB77C"
  - "\uC801 \uCABD\uC744 <b>\uD074\uB9AD</b>! \uADF8\uCABD \uBC43\uC804\uC774 \uC77C\uC81C
    \uC0AC\uACA9\uD55C\uB2E4 (Q \xB7 E \uB3C4 \uB428)"
  - "\uC801\uC744 \uAC00\uB77C\uC549\uD788\uBA74 <b>\uAE08\uD654 \xB7 \uBAA9\uC7AC</b>\uAC00
    \uB5A8\uC5B4\uC9C4\uB2E4. \uAC00\uAE4C\uC774 \uAC00\uC11C \uC8FC\uC6CC\uB77C"
  - "<b>\uBCF4\uAE09 \uC0C1\uC790</b>(\uCE58\uC988 \uADF8\uB9BC)\uB97C \uC3F4\uC11C
    \uBD80\uC218\uBA74 \uC544\uC774\uD15C\uC774 \uB098\uC628\uB2E4"
  - "\uC544\uC774\uD15C\uC744 \uC5BB\uC5C8\uB2E4! <b>F</b> \uB85C \uC368\uB77C (\uD558\uB098\uB9CC
    \uB4E4 \uC218 \uC788\uACE0, \uC0C8\uB85C \uC8FC\uC6B0\uBA74 \uBC14\uB01C)"
  doneText: "\uC88B\uC544, \uC774\uC81C \uBC14\uB2E4\uB294 \uB124 \uAC83\uC774\uB2E4!
    \uC77C\uACF1 \uBC14\uB2E4\uB97C \uC815\uBCF5\uD558\uB77C!"
  tips:
  - key: obj_Treasure
    title: "\uBCF4\uBB3C\uC0C1\uC790"
    text: "\uD3EC\uD0C4\uC73C\uB85C \uBD80\uC234\uC57C \uC5F4\uB9BC. \uAE08\uD654\uAC00
      \uC794\uB729!"
  - key: obj_Supply
    title: "\uBCF4\uAE09 \uC0C1\uC790"
    text: "\uBD80\uC218\uBA74 \uC544\uC774\uD15C \xB7 \uAE08\uD654 \uC870\uAE08"
  - key: obj_BombCrate
    title: "\uD3ED\uD0C4 \uC0C1\uC790"
    text: "\uB2FF\uAC70\uB098 \uB9DE\uC73C\uBA74 \uD391! \uC801 \uADFC\uCC98\uC5D0\uC11C
      \uD130\uB728\uB824\uB77C"
  - key: obj_Reef
    title: "\uC554\uCD08"
    text: "\uD3EC\uD0C4\uC744 \uB9C9\uC544 \uC90C. \uB4A4\uC5D0 \uC228\uC5B4 \uC7A5\uC804\uD558\uB77C"
  - key: obj_Wreck
    title: "\uB09C\uD30C\uC120"
    text: "\uD3EC\uD0C4\uC744 \uB9C9\uB2E4\uAC00 \uB9CE\uC774 \uB9DE\uC73C\uBA74
      \uBD80\uC11C\uC9D0"
  - key: obj_Current
    title: "\uD574\uB958"
    text: "\uD654\uC0B4\uD45C \uCABD\uC73C\uB85C \uBC00\uB9BC. \uD0C0\uBA74 \uBE60\uB974\uACE0
      \uAC70\uC2A4\uB974\uBA74 \uB290\uB9BC"
  - key: obj_Wind
    title: "\uBC14\uB78C \uAD6C\uC5ED"
    text: "\uBC30\uB3C4 \uD3EC\uD0C4\uB3C4 \uBC14\uB78C\uC5D0 \uBC00\uB9BC. \uC870\uC900\uD560
      \uB54C \uAC10\uC548!"
  - key: foe_shark
    title: "\uC0C1\uC5B4"
    text: "\uC9C0\uB290\uB7EC\uBBF8\uB9CC \uBCF4\uC77C \uB550 \uC7A0\uC218 \uC911.
      \uB5A0\uC624\uB97C \uB54C \uC3F4\uB77C"
  - key: foe_mine
    title: "\uB5A0\uB2E4\uB2C8\uB294 \uD3ED\uD0C4\uD1B5"
    text: "\uBD80\uB52A\uD788\uBA74 \uD130\uC9D0. \uBA40\uB9AC\uC11C \uC3F4\uC11C
      \uCE58\uC6CC\uB77C"
  - key: foe_speeder
    title: "\uCF8C\uC18D\uC815"
    text: "\uBE60\uB974\uAC8C \uB4E4\uC774\uBC1B\uC74C. \uB2E4\uAC00\uC624\uAE30
      \uC804\uC5D0 \uC3F4\uB77C"
  - key: foe_mortar
    title: "\uBC15\uACA9\uD3EC\uC120"
    text: "\uBE68\uAC04 \uC6D0\uC774 \uB5A8\uC5B4\uC9C8 \uACF3. \uC6D0 \uBC16\uC73C\uB85C
      \uD53C\uD558\uB77C"
  - key: boss
    title: "\uBCF4\uC2A4 \uCD9C\uD604!"
    text: "\uCCB4\uB825\uC774 \uB9CE\uB2E4. \uC544\uC774\uD15C\uC744 \uC544\uAEF4
      \uB480\uB2E4\uBA74 \uC9C0\uAE08 \uC368\uB77C"
  - key: loot
    title: "\uC2B9\uB9AC!"
    text: "\uB5A8\uC5B4\uC9C4 \uC804\uB9AC\uD488\uC744 \uC90D\uACE0 Enter \uB85C
      \uD56D\uAD6C\uB85C"
  - key: item_drop
    title: "\uC544\uC774\uD15C"
    text: "\uAC00\uAE4C\uC774 \uAC00\uBA74 \uC8FC\uC6C0. 12\uCD08 \uB4A4 \uC0AC\uB77C\uC9D0"
